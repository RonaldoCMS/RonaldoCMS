# Copia questo file in .env.local (in sviluppo) o imposta le variabili su Vercel (in produzione).

# Indirizzo pubblico del sito: usato per sitemap, indirizzi canonici e anteprime social.
NEXT_PUBLIC_SITE_URL=https://danubbio.it

# Modulo di contatto (Resend, https://resend.com).
# Senza RESEND_API_KEY il modulo risponde che non è ancora attivo.
RESEND_API_KEY=
# Dove arrivano i messaggi.
CONTACT_TO_EMAIL=fabio@danubbio.it
# Mittente: deve appartenere a un dominio verificato su Resend (per esempio danubbio.it).
CONTACT_FROM_EMAIL="Sito danubbio.it <noreply@danubbio.it>"
